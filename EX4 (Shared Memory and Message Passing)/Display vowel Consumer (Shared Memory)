#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#define SHM_SIZE 100
int main()
{
    key_t key;
    int shmid;
    char *sharedData;
    char *ptr;
    FILE *file;
    file = fopen("/tmp/shmkeyfile", "r");
    if (file == NULL)
    {
        perror("fopen");
        printf("Run the producer program first\n");
        return 1;
    }
    fclose(file);
    key = ftok("/tmp/shmkeyfile", 'A');
    if (key == -1)
    {
        perror("ftok");
        return 1;
    }
    shmid = shmget(key, SHM_SIZE, 0666);
    if (shmid == -1)
    {
        perror("shmget");
        printf("Run the producer program first\n");
        return 1;
    }
    sharedData = (char *)shmat(shmid, NULL, 0);
    if (sharedData == (char *)-1)
    {
        perror("shmat");
        return 1;
    }
    printf("\nConsumer: Received string = %s\n", sharedData);
    printf("Vowels in the string: ");
    ptr = sharedData;
    while (*ptr != '\0')
    {
        if (*ptr == 'a' || *ptr == 'e' || *ptr == 'i' ||
            *ptr == 'o' || *ptr == 'u' ||
            *ptr == 'A' || *ptr == 'E' || *ptr == 'I' ||
            *ptr == 'O' || *ptr == 'U')
        {
            printf("%c ", *ptr);
        }
        ptr++;
    }
    printf("\n");
    if (shmdt(sharedData) == -1)
    {
        perror("shmdt");
        return 1;
    }
    if (shmctl(shmid, IPC_RMID, NULL) == -1)
    {
        perror("shmctl");
        return 1;
    }
    return 0;
}
