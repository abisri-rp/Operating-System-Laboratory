#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

int main()
{
    int shmid;
    int *sharedData;
    pid_t pid;
    int i;

    // Allocate space for 19 integers:
    // Indices 0-8: Matrix A
    // Indices 9-17: Matrix B
    // Index 18: Flag (0 = waiting for input, 1 = input complete)
    shmid = shmget(IPC_PRIVATE, 19 * sizeof(int), IPC_CREAT | 0666);
    if (shmid == -1)
    {
        perror("shmget");
        return 1;
    }

    sharedData = (int *)shmat(shmid, NULL, 0);
    if (sharedData == (int *)-1)
    {
        perror("shmat");
        return 1;
    }

    // Initialize the synchronization flag to 0 (Not Ready)
    sharedData[18] = 0;

    pid = fork();
    if (pid < 0)
    {
        perror("fork");
        return 1;
    }

    if (pid > 0) // Parent Process (P1)
    {
        printf("P1 - Enter first 3 x 3 matrix:\n");
        for (i = 0; i < 9; i++)
        {
            scanf("%d", &sharedData[i]);
        }

        printf("\nP1 - Enter second 3 x 3 matrix:\n");
        for (i = 0; i < 9; i++)
        {
            scanf("%d", &sharedData[9 + i]);
        }

        printf("\nP1 - Matrices stored in shared memory.\n");

        // Signal P2 that data entry is fully finished
        sharedData[18] = 1;

        // Wait for P2 to finish printing before cleaning up memory
        wait(NULL);

        if (shmdt(sharedData) == -1)
        {
            perror("shmdt");
            return 1;
        }
        if (shmctl(shmid, IPC_RMID, NULL) == -1)
        {
            perror("shmctl");
            return 1;
        }
    }
    else // Child Process (P2)
    {
        // Busy-wait loop: Keep checking the flag until P1 updates it to 1
        while (sharedData[18] == 0)
        {
            usleep(10000); // Sleep for 10 milliseconds to save CPU power
        }

        printf("\nP2 - Sum of the two matrices:\n");
        for (i = 0; i < 9; i++)
        {
            printf("%d\t", sharedData[i] + sharedData[9 + i]);

            if ((i + 1) % 3 == 0)
            {
                printf("\n");
            }
        }

        if (shmdt(sharedData) == -1)
        {
            perror("shmdt");
            exit(1);
        }
        exit(0);
    }
    return 0;
}
