#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>
struct message
{
    long messageType;
    char text[500];
};
int main()
{
    key_t key;
    int msgid;
    struct message msg;
    key = ftok("progfile", 65);
    msgid = msgget(key, 0666 | IPC_CREAT);
    if (msgid == -1)
    {
        perror("msgget");
        exit(1);
    }
    msg.messageType = 1;
    printf("Enter message: ");
    fgets(msg.text, sizeof(msg.text), stdin);
    if (msgsnd(msgid, &msg, sizeof(msg.text), 0) == -1)
    {
        perror("msgsnd");
        exit(1);
    }
    printf("Producer: Message sent.\n");
    return 0;
}
