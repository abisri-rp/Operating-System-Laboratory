#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <ctype.h>
struct message
{
    long messageType;
    char text[500];
};
int main()
{
    key_t key;
    int msgid;
    struct message msg;
    int words = 0;
    int inWord = 0;
    int i;
    key = ftok("progfile", 65);
    msgid = msgget(key, 0666 | IPC_CREAT);
    if (msgid == -1)
    {
        perror("msgget");
        exit(1);
    }
    if (msgrcv(msgid, &msg, sizeof(msg.text), 1, 0) == -1)
    {
        perror("msgrcv");
        exit(1);
    }
    printf("\nConsumer: Message received\n");
    printf("Message: %s", msg.text);
    for (i = 0; msg.text[i] != '\0'; i++)
    {
        if (!isspace((unsigned char)msg.text[i]))
        {
            if (inWord == 0)
            {
                words++;
                inWord = 1;
            }
        }
        else
        {
            inWord = 0;
        }
    }
    printf("Number of words = %d\n", words);
    msgctl(msgid, IPC_RMID, NULL);
    return 0;
}
