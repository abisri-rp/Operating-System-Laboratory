#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>
struct message
{
    long messageType;
    char text[1000];
};
int main()
{
    key_t key;
    int msgid;
    struct message msg;
    FILE *fp;
    key = ftok("fileprog", 75);
    msgid = msgget(key, 0666 | IPC_CREAT);
    if (msgid == -1)
    {
        perror("msgget");
        exit(1);
    }
    fp = fopen("source.txt", "r");
    if (fp == NULL)
    {
        perror("fopen");
        exit(1);
    }
    msg.messageType = 1;
    while (fgets(msg.text, sizeof(msg.text), fp) != NULL)
    {
        if (msgsnd(msgid, &msg, sizeof(msg.text), 0) == -1)
        {
            perror("msgsnd");
            fclose(fp);
            exit(1);
        }
    }
    strcpy(msg.text, "END");
    if (msgsnd(msgid, &msg, sizeof(msg.text), 0) == -1)
    {
        perror("msgsnd");
        fclose(fp);
        exit(1);
    }
    fclose(fp);
    printf("Producer: File sent successfully.\n");
    return 0;
}
