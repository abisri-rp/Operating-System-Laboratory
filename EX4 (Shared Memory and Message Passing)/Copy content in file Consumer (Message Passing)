#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>
struct message
{
    long messageType;
    char text[1000];
};
int main()
{
    key_t key;
    int msgid;
    struct message msg;
    FILE *fp;
    key = ftok("fileprog", 75);
    msgid = msgget(key, 0666 | IPC_CREAT);
    if (msgid == -1)
    {
        perror("msgget");
        exit(1);
    }
    fp = fopen("destination.txt", "w");
    if (fp == NULL)
    {
        perror("fopen");
        exit(1);
    }
    while (1)
    {
        if (msgrcv(msgid, &msg, sizeof(msg.text), 1, 0) == -1)
        {
            perror("msgrcv");
            fclose(fp);
            exit(1);
        }
        if (strcmp(msg.text, "END") == 0)
        {
            break;
        }
        fprintf(fp, "%s", msg.text);
    }
    fclose(fp);
    printf("Consumer: File copied successfully.\n");
    msgctl(msgid, IPC_RMID, NULL);
    return 0;
}
