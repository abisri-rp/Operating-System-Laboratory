void calculateRoundRobin(Process p[], int n, int tq, float *avgWT, float *avgTAT)
{
    int i;
    int completed = 0;
    int flag;
    float time = 0;
    *avgWT = 0;
    *avgTAT = 0;
    for(i = 0; i < n; i++)
        p[i].rt = p[i].bt;
    while(completed < n)
    {
        flag = 0;
        for(i = 0; i < n; i++)
        {
            if(p[i].at <= time && p[i].rt > 0)
            {
                flag = 1;
                if(p[i].rt > tq)
                {
                    time += tq;
                    p[i].rt -= tq;
                }
                else
                {
                    time += p[i].rt;
                    p[i].rt = 0;
                    p[i].ct = time;
                    p[i].tat = p[i].ct - p[i].at;
                    p[i].wt = p[i].tat - p[i].bt;
                    if(p[i].wt < 0)
                        p[i].wt = 0;
                    *avgWT += p[i].wt;
                    *avgTAT += p[i].tat;
                    completed++;
                }
            }
        }
        if(flag == 0)
            time++;
    }
    *avgWT /= n;
    *avgTAT /= n;
}
void printResults(Process p[], int n, float avgWT, float avgTAT)
{
    int i;
    printf("\n-------------------------------------------------------------");
    printf("\nProcess\tAT\tBT\tCT\tTAT\tWT");
    printf("\n-------------------------------------------------------------");
    for(i = 0; i < n; i++)
    {
        printf("\nP%d\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f",p[i].id,p[i].at,p[i].bt,p[i].ct,p[i].tat,p[i].wt);
    }
    printf("\n-------------------------------------------------------------");
    printf("\nAverage Turnaround Time = %.2f", avgTAT);
    printf("\nAverage Waiting Time = %.2f\n", avgWT);
}

